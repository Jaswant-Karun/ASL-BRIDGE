{
  "id": "asl-bridge-speech-to-asl",
  "name": "ASL Bridge - Speech to ASL",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "asl/speech", "responseMode": "responseNode" }, "id": "speech-webhook", "name": "Receive Transcript", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "asl-bridge-speech" },
    { "parameters": { "jsCode": "const text = String($json.body?.text || $json.body?.transcript || $json.text || '').trim();\nif (!text) throw new Error('transcript is required');\nreturn [{ json: { text } }];" }, "id": "prepare-speech", "name": "Prepare Transcript", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [240, 0] },
    { "parameters": { "method": "POST", "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={{$env.GEMINI_API_KEY}}", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { contents: [{ parts: [{ text: 'Convert this spoken English transcript into an ASL-oriented uppercase gloss sequence. Return JSON only with a gloss array. Transcript: ' + $json.text }] }] } }}", "options": {} }, "id": "gemini-speech", "name": "Gemini Gloss", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [500, 0] },
    { "parameters": { "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '{\"gloss\":[]}';\nconst parsed = JSON.parse(raw.replace(/^```json\\s*|\\s*```$/g, '').trim());\nreturn [{ json: { gloss: (parsed.gloss || []).map((token) => String(token).toUpperCase()) } }];" }, "id": "parse-speech-gloss", "name": "Parse Gloss", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [760, 0] },
    { "parameters": { "method": "POST", "url": "={{$env.BACKEND_API_URL}}/asl/map", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ $json }}", "options": {} }, "id": "map-speech", "name": "Map ASL Signs", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1000, 0] },
    { "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": {} }, "id": "respond-speech", "name": "Return ASL Result", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1240, 0] }
  ],
  "connections": { "Receive Transcript": { "main": [[{ "node": "Prepare Transcript", "type": "main", "index": 0 }]] }, "Prepare Transcript": { "main": [[{ "node": "Gemini Gloss", "type": "main", "index": 0 }]] }, "Gemini Gloss": { "main": [[{ "node": "Parse Gloss", "type": "main", "index": 0 }]] }, "Parse Gloss": { "main": [[{ "node": "Map ASL Signs", "type": "main", "index": 0 }]] }, "Map ASL Signs": { "main": [[{ "node": "Return ASL Result", "type": "main", "index": 0 }]] } },
  "active": false,
  "settings": {},
  "versionId": "asl-bridge-speech-v1",
  "meta": { "templateCredsSetupCompleted": true }
