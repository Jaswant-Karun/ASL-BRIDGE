{
  "id": "asl-bridge-text-to-asl",
  "name": "ASL Bridge - Text to ASL",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "asl/text", "responseMode": "responseNode" }, "id": "text-webhook", "name": "Receive Text", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "asl-bridge-text" },
    { "parameters": { "jsCode": "const text = String($json.body?.text || $json.text || '').trim();\nif (!text) throw new Error('text is required');\nreturn [{ json: { text } }];" }, "id": "prepare-text", "name": "Prepare Text", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [220, 0] },
    { "parameters": { "method": "POST", "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{$env.GEMINI_API_KEY}}", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { contents: [{ parts: [{ text: 'Convert this English sentence into an ASL-oriented uppercase gloss sequence. Return JSON only with a gloss array and no explanation. Text: ' + $json.text }] }] } }}", "options": {} }, "id": "gemini-text", "name": "Gemini Gloss", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [460, 0] },
    { "parameters": { "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '{\"gloss\":[]}';\nconst cleaned = raw.replace(/^```json\\s*|\\s*```$/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nreturn [{ json: { gloss: (parsed.gloss || []).map((token) => String(token).toUpperCase()) } }];" }, "id": "parse-gloss", "name": "Parse Gloss", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [700, 0] },
    { "parameters": { "method": "POST", "url": "={{$env.BACKEND_API_URL}}/asl/map", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ $json }}", "options": {} }, "id": "map-text", "name": "Map ASL Signs", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [940, 0] },
    { "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": {} }, "id": "respond-text", "name": "Return ASL Result", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1180, 0] }
  ],
  "connections": { "Receive Text": { "main": [[{ "node": "Prepare Text", "type": "main", "index": 0 }]] }, "Prepare Text": { "main": [[{ "node": "Gemini Gloss", "type": "main", "index": 0 }]] }, "Gemini Gloss": { "main": [[{ "node": "Parse Gloss", "type": "main", "index": 0 }]] }, "Parse Gloss": { "main": [[{ "node": "Map ASL Signs", "type": "main", "index": 0 }]] }, "Map ASL Signs": { "main": [[{ "node": "Return ASL Result", "type": "main", "index": 0 }]] } },
  "active": false,
  "settings": {},
  "versionId": "asl-bridge-text-v1",
  "meta": { "templateCredsSetupCompleted": true }
